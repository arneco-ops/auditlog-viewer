{
  "xsappname": "auditlog-viewer",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Admin scope for full access"
    },
    {
      "name": "$XSAPPNAME.Viewer",
      "description": "Viewer scope for read-only access"
    }
  ],
  "attributes": [],
  "role-templates": [
    {
      "name": "Admin",
      "description": "Full administrative access",
      "scope-references": [
        "$XSAPPNAME.Admin"
      ],
      "attribute-references": []
    },
    {
      "name": "Viewer",
      "description": "Read-only access to audit logs",
      "scope-references": [
        "$XSAPPNAME.Viewer"
      ],
      "attribute-references": []
    }
  ],
  "role-collections": [
    {
      "name": "AuditLogViewer_Admin",
      "description": "Administrative access to Audit Log Viewer",
      "role-template-references": [
        "$XSAPPNAME.Admin"
      ]
    },
    {
      "name": "AuditLogViewer_Viewer",
      "description": "Read-only access to Audit Log Viewer",
      "role-template-references": [
        "$XSAPPNAME.Viewer"
      ]
    }
  ],
  "oauth2-configuration": {
    "redirect-uris": [
      "https://*.cfapps.*.hana.ondemand.com/**",
      "https://*.applicationstudio.cloud.sap/**"
    ]
  }
}
