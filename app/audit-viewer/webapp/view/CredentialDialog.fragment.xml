<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form">
  
  <Dialog
    title="{= ${dialog>/editMode} ? 'Edit Credential' : 'Add Credential'}"
    contentWidth="600px">
    <content>
      <f:SimpleForm
        editable="true"
        layout="ResponsiveGridLayout"
        labelSpanXL="4"
        labelSpanL="4"
        labelSpanM="4"
        labelSpanS="12"
        adjustLabelSpan="false"
        emptySpanXL="0"
        emptySpanL="0"
        emptySpanM="0"
        emptySpanS="0"
        columnsXL="1"
        columnsL="1"
        columnsM="1"
        singleContainerFullSize="false">
        <f:content>
          <Label text="Name" required="true"/>
          <Input
            value="{dialog>/name}"
            placeholder="e.g., Production Audit Log"/>
          
          <Label text="URL" required="true"/>
          <Input
            value="{dialog>/url}"
            placeholder="https://auditlog-management.cfapps.{region}.hana.ondemand.com"/>
          
          <Label text="Client ID" required="true"/>
          <Input
            value="{dialog>/clientId}"
            placeholder="OAuth Client ID"/>
          
          <Label text="Client Secret" required="true"/>
          <Input
            value="{dialog>/clientSecret}"
            type="Password"
            placeholder="OAuth Client Secret"/>
          
          <Label text="Auth URL" required="true"/>
          <Input
            value="{dialog>/authUrl}"
            placeholder="https://{subdomain}.authentication.{region}.hana.ondemand.com/oauth/token"/>
          
          <Label text="Active"/>
          <Switch
            state="{dialog>/isActive}"/>
        </f:content>
      </f:SimpleForm>
    </content>
    <beginButton>
      <Button
        text="Save"
        type="Emphasized"
        press="onSaveCredential"/>
    </beginButton>
    <endButton>
      <Button
        text="Cancel"
        press="onCancelCredential"/>
    </endButton>
  </Dialog>
  
</core:FragmentDefinition>
